# Copy this file to backend/.env and fill in the values from
# Supabase -> Project Settings -> API.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security.
# Keep it server-side only. Never commit it, never put it in frontend code.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public address where users open the app. Keep localhost for local testing.
APP_URL=http://localhost:3000

# Optional
PORT=3000
